# 复制为 .env 后按实际环境填写。真实密钥不要提交到仓库。

# 兼容 OpenAI 协议的模型接口；留空则报告走模板化兜底
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# 向量接口：text=标准 OpenAI 兼容 /embeddings（一次可传多条）
#          multimodal=方舟 /embeddings/multimodal，整个 input 列表会被融合成一个向量，
#          因此每条文本单独发一次请求；doubao-embedding-vision 系列只能用这个
EMBEDDING_API=text
# auto: 有 Key 用模型、无 Key 用模板；always: 强制用模型；never: 强制用模板
USE_LLM=auto

# local: 进程内调用（公开演示推荐）；stdio: 通过真实 MCP 服务验证协议链路
MCP_MODE=local
# 留空则默认用当前解释器启动 app/mcp/server.py
# 路径含空格时可写成 JSON 数组，例如：
# MCP_SERVER_CMD=["C:\\Program Files\\Python312\\python.exe","-m","app.mcp.server"]
# 也可用引号包裹路径（Windows 反斜杠不会被当转义符）：
# MCP_SERVER_CMD="C:\Program Files\Python312\python.exe" -m app.mcp.server
MCP_SERVER_CMD=

# Agent 约束
MAX_TOOL_CALLS=8
LLM_TIMEOUT=20
LLM_MAX_RETRIES=1
MAX_UPLOAD_BYTES=20971520

# RAG 检索
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35

# 持久化向量库（Chroma）：配置了 embedding 后需先执行
#   python -m app.rag.ingest --rebuild
# 未配置 embedding 时不会发起任何网络请求，自动只走 BM25
CHROMA_DIR=
CHROMA_COLLECTION=bearing_knowledge
RAG_VECTOR_WEIGHT=0.6
RAG_BM25_WEIGHT=0.4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
# 真实 embedding 通过独立评测后再开启；默认 false，线上使用 BM25 保证术语召回可解释
ENABLE_HYBRID_RETRIEVAL=false

# 会话与对话消息落盘（SQLite）；留空默认 data/sessions.db，服务重启不丢
SESSIONS_DB_PATH=
# 自由问答带进提示词的最近对话轮数（1 轮 = 用户问 + 助手答，单条超 400 字符截断）
CHAT_HISTORY_TURNS=3
